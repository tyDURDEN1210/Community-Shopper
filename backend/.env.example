# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Replica Set Connection URI
# Required in production (e.g., MongoDB Atlas mongodb+srv://...).
# Never falls back to MongoMemoryReplSet when NODE_ENV=production.
MONGODB_URI=mongodb://127.0.0.1:27017/campus_cart?replicaSet=rs0
USE_IN_MEMORY_DB=false

# Authentication & Security (Replace with a strong 64+ character random secret in production)
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_for_jwt_signing
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Optional CORS Origin (Same-origin requests are allowed automatically; set for local Vite dev server)
CORS_ORIGIN=http://localhost:5173
