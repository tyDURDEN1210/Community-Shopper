# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Replica Set Connection URI
# Note: MongoDB must be configured as a replica set for multi-document transactions.
# For local development without a running MongoDB instance, set USE_IN_MEMORY_DB=true
# to automatically launch a local MongoDB replica set via mongodb-memory-server.
MONGODB_URI=mongodb://127.0.0.1:27017/campus_cart?replicaSet=rs0
USE_IN_MEMORY_DB=false

# Authentication & Security (Replace with a strong 64+ character random secret in production)
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_for_jwt_signing
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# CORS & Frontend Origin
CORS_ORIGIN=http://localhost:5173

