# Root Environment Variables Reference (Single Render Web Service Deployment)
# In production on Render, configure these variables in the Render Dashboard or via render.yaml:

NODE_ENV=production
PORT=10000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus_cart?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_for_jwt_signing
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Optional: Only needed if serving frontend from a separate domain (same-origin is allowed automatically)
# CORS_ORIGIN=https://your-service.onrender.com
