# Root Environment Variables Reference
# Copy backend/.env.example to backend/.env and frontend/.env.example to frontend/.env

# Backend Variables
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campus_cart?replicaSet=rs0
USE_IN_MEMORY_DB=false
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_for_jwt_signing
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# Frontend Variables
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

