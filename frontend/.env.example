# Optional Frontend Environment Variables
# Leave unset in production when deployed as a single unified Render web service:
# the frontend automatically uses same-origin '/api/v1' and window.location.origin for Socket.IO.
# In local development, Vite proxies '/api' and '/socket.io' to http://localhost:5000 automatically.
# VITE_API_BASE_URL=http://localhost:5000/api/v1
# VITE_SOCKET_URL=http://localhost:5000
